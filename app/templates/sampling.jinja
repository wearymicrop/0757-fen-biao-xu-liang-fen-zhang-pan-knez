{% from 'proof.jinja' import evidence %}
<div class="panel-title"><h2>校时取样记录</h2><span>采信 {{ current.counts.accepted }} · 重传 {{ current.counts.replay }} · 隔离 {{ current.counts.quarantined }}</span></div>
<div class="scroll"><table><thead><tr><th>表号</th><th>校正时间 UTC</th><th class="num">偏移 s</th><th class="num">功率 W</th><th>来源</th></tr></thead><tbody>{% for row in current.samples %}<tr><td>{{ row.meter }}</td><td>{{ row.timestamp }}</td><td class="num">{{ row.offset_seconds }}</td><td class="num">{{ row.w }}</td><td>{{ evidence([row.source]) }}</td></tr>{% else %}<tr><td colspan="5">暂无有效取样。</td></tr>{% endfor %}</tbody></table></div>
