<div class="panel-title"><h2>共同峰勾稽表</h2><strong id="balance-state">{% if current.status=='MATCHED' %}功率已对平{% elif current.status=='REVIEW' %}对平 · 待复核{% elif current.status=='NO_PEAK' %}无完整窗口{% else %}存在差异{% endif %}</strong></div>
<div class="scroll"><table><thead><tr><th>项目</th><th class="num">功率 kW</th><th class="num">三点瓦数和 W</th></tr></thead><tbody>{% for label,key in [('总表共同峰','main'),('已归因贡献','assigned'),('未映射分表','unmapped'),('总分表差','residual'),('未分配量','unallocated')] %}<tr><td>{{ label }}</td><td class="num">{{ current[key ~ '_kw'] or '—' }}</td><td class="num">{{ current.get(key ~ '_w_sum','—') }}</td></tr>{% endfor %}</tbody></table></div>
<div class="footnote">功率差额 {{ current.difference_w_sum if current.difference_w_sum is not none else '—' }} W · 读数差额 {{ current.reading_difference }} 条</div>
